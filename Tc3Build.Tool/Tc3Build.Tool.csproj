<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Version>0.2.0</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <PackageId>Tc3Build</PackageId>
    <Description>Dotnet tool launcher for Tc3Build TwinCAT 3 build automation.</Description>
    <PackageTags>twincat;beckhoff;automation;build;plc;ci</PackageTags>
    <RepositoryUrl>https://github.com/danielwiege/tc3-build</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>tc3build</ToolCommandName>
    <HostOutputPath>$(MSBuildThisFileDirectory)..\Tc3Build\Tc3Build\bin\$(Platform)\$(Configuration)\net10.0-windows</HostOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
    <None Include="$(HostOutputPath)\**\*"
          Exclude="$(HostOutputPath)\publish\**\*;$(HostOutputPath)\win-x64\**\*"
          Pack="true"
          PackagePath="tools\net10.0\any" />
  </ItemGroup>

  <Target Name="BuildTc3BuildHost" BeforeTargets="Build">
    <MSBuild
      Projects="$(MSBuildThisFileDirectory)..\Tc3Build\Tc3Build\Tc3Build.csproj"
      Targets="Build"
      Properties="Configuration=$(Configuration);Platform=$(Platform)" />
  </Target>
</Project>
